# Copy to .env and fill in. .env is git-ignored; never commit real values.
# In CI, set these as GitHub Actions secrets instead of a file.
#
# Consumed by:
#   src/tests/live/security_matrix.live.test.js
#   src/tests/live/service_account_cross_tenant_isolation.live.test.js
#   src/tests/live/end_user_cross_user_isolation.live.test.js
# Each block self-skips when its variables are absent, so a partial file is fine.

# ---------------------------------------------------------------- endpoints
FHIR_BASE_URL=https://fhir.staging.icanbwell.com
TOKEN_URL=https://staging-icanbwell.auth.us-east-1.amazoncognito.com/oauth2/token
LOGIN_URL=https://api-gateway.staging.icanbwell.com/identity/account/login

# Set to 1 to enable the live suites. Absent means every live block skips.
RUN_LIVE_ISOLATION=

# ---------------------------------------------------------------- service accounts
# Read-only account scoped to one synthetic QA tenant.
#   required scope: access/<QA_TENANT>.* user/*.read
SA_RO_CLIENT_ID=
SA_RO_CLIENT_SECRET=

# Read/write account scoped to the same tenant.
#   required scope: access/<QA_TENANT>.* user/*.read user/*.write
SA_RW_CLIENT_ID=
SA_RW_CLIENT_SECRET=

# The tenant those accounts are scoped to, and two records it owns.
QA_TENANT=
QA_PATIENT_ID=
QA_PERSON_ID=

# A different tenant and two records it owns. These must never be visible
# to the accounts above.
FOREIGN_TENANT=
FOREIGN_PATIENT_ID=
FOREIGN_PERSON_ID=

# Optional. A token that CAN read FOREIGN_PATIENT_ID, used only to confirm the
# target exists. Without it, a passing result cannot be distinguished from the
# record being absent, and the reachability controls skip.
GROUND_TRUTH_TOKEN=

# ---------------------------------------------------------------- shared upstream bridge
# Two client tenants whose patients both link to one upstream PROA record.
# This is the case closest to INC-331 and cannot be built in narrow integration.
BRIDGE_TENANT_A=
BRIDGE_TENANT_B=
BRIDGE_A_CLIENT_ID=
BRIDGE_A_CLIENT_SECRET=
BRIDGE_A_PERSON_ID=
BRIDGE_A_PATIENT_ID=
BRIDGE_B_PERSON_ID=
BRIDGE_B_PATIENT_ID=
BRIDGE_UPSTREAM_PATIENT_ID=

# ---------------------------------------------------------------- end users
# Two end users in the same client tenant who must not see each other.
# End-user tokens come from a different identity pool than service accounts, so
# these reach the Application API rather than the FHIR server directly.
CLIENTKEY=
USER_A_EMAIL=
USER_A_PASSWORD=
USER_A_PERSON_ID=
USER_A_PATIENT_ID=
USER_B_EMAIL=
USER_B_PASSWORD=
USER_B_PERSON_ID=
USER_B_PATIENT_ID=
